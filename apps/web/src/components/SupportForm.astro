---
import type { Service, Course } from '@ltsp/shared';
interface Props { services: Service[]; courses: Course[]; values: Record<string, string>; errors: Record<string, string>; }
const { services, courses, values: v, errors } = Astro.props;
const kinds = [['care', 'Support or home visit'], ['callback', 'A callback'], ['referral', 'Refer someone'], ['training-group', 'Group training'], ['training-private', 'Private training']];
---
<form method="post" action="/support" class="form-panel">
  <h2>Let’s start a conversation.</h2><p>Share a little about what you need. You can leave the details for your conversation with the nurse.</p>
  {Object.keys(errors).length > 0 && <div class="notice error" role="alert" tabindex="-1" id="form-errors"><strong>Please check the following:</strong><ul>{Object.entries(errors).map(([field, error]) => <li><a href={`#${field}`}>{error}</a></li>)}</ul></div>}
  <div class="honeypot" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <div class="field"><label for="kind">I’m getting in touch about</label><select name="kind" id="kind">{kinds.map(([value, label]) => <option value={value} selected={v.kind === value}>{label}</option>)}</select></div>
  <div class="field-grid"><div class="field"><label for="name">Your name</label><input id="name" name="name" value={v.name} required maxlength="100" autocomplete="name" aria-invalid={!!errors.name} /></div><div class="field"><label for="phone">Contact phone number</label><input id="phone" name="phone" type="tel" value={v.phone} required maxlength="25" autocomplete="tel" placeholder="e.g. +254 7…" aria-invalid={!!errors.phone} /></div></div>
  <div class="field-grid"><div class="field"><label for="email">Email address <span class="muted">(optional)</span></label><input id="email" name="email" type="email" value={v.email} maxlength="150" autocomplete="email" aria-invalid={!!errors.email} /></div><div class="field"><label for="preferredContact">How should we reply?</label><select id="preferredContact" name="preferredContact">{[['phone', 'Phone call'], ['whatsapp', 'WhatsApp'], ['email', 'Email']].map(([value, label]) => <option value={value} selected={v.preferredContact === value}>{label}</option>)}</select></div></div>
  <div class="field-grid"><div class="field"><label for="service">Service <span class="muted">(if known)</span></label><select id="service" name="service"><option value="">Help me find the right support</option>{services.map(service => <option value={service.slug} selected={v.service === service.slug}>{service.title}{service.free ? ' · Free' : ''}</option>)}</select></div><div class="field"><label for="course">Training course <span class="muted">(if relevant)</span></label><select id="course" name="course"><option value="">Not applicable / please advise</option>{courses.map(course => <option value={course.slug} selected={v.course === course.slug}>{course.title}</option>)}</select></div></div>
  <div class="field-grid"><div class="field"><label for="relationship">You are enquiring for</label><select id="relationship" name="relationship">{[['self', 'Myself'], ['family', 'A family member'], ['employer', 'My household or organisation'], ['professional', 'Someone I am referring professionally']].map(([value, label]) => <option value={value} selected={v.relationship === value}>{label}</option>)}</select></div><div class="field"><label for="ageGroup">Person needing support</label><select id="ageGroup" name="ageGroup">{[['adult', 'An adult'], ['child', 'A child or young person'], ['not-applicable', 'Not applicable / training enquiry']].map(([value, label]) => <option value={value} selected={v.ageGroup === value}>{label}</option>)}</select></div></div>
  <div class="field-grid"><div class="field"><label for="area">Area or neighbourhood <span class="muted">(optional)</span></label><input id="area" name="area" value={v.area} maxlength="150" /><small>An exact home address is not needed yet.</small></div><div class="field"><label for="availability">Good times to contact you <span class="muted">(optional)</span></label><input id="availability" name="availability" value={v.availability} maxlength="200" placeholder="e.g. weekday afternoons" /></div></div>
  <div class="field"><label for="message">What support would help? <span class="muted">(optional)</span></label><textarea id="message" name="message" maxlength="1500" aria-describedby="message-help">{v.message}</textarea><small id="message-help">A brief description is enough. Please avoid detailed medical history, identity numbers or financial records.</small></div>
  <label class="check-label"><input id="consent" type="checkbox" name="consent" required checked={v.consent === 'on'} /><span>I have read the <a href="/privacy">privacy information</a> and understand that the team will use these details to review and respond to my request.</span></label>
  <button class="button" type="submit">Send my request <span aria-hidden="true">↗</span></button><p class="small-note">Submitting a request does not confirm an appointment or a training place.</p>
</form>
