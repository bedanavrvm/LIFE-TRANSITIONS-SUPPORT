---
import RichContent from './RichContent.astro';
import ContentMedia from './ContentMedia.astro';
import CareIcon from './CareIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ContentFrame from '../layouts/ContentFrame.astro';
import CarePhoto from './CarePhoto.astro';
import { coursePhotography } from '../lib/photography';
import { formatDate, money } from '../lib/cms';

const { course, settings, preview = false } = Astro.props;
---
<SiteLayout title={course?.title || 'Course unavailable'} preview={preview} settings={settings} meta={{ ...course?.meta, image: course?.meta?.image || course?.image }} description={course?.summary}>
  <ContentFrame>
    <Fragment slot="intro"><span class="eyebrow">{course?.audience || 'Caregiver training'}</span><h1>{course?.title || 'We couldn’t find that course.'}</h1><p>{course?.summary || 'Please return to the training page or try again shortly.'}</p></Fragment>
    {course && <><CarePhoto asset={course.image} photo={coursePhotography[course.slug] ?? 'companionship'} class="detail-photo" sizes="(max-width: 1100px) calc(100vw - 48px), 876px" /><RichContent body={course.body} fallback={course.details} /><ContentMedia content={course} /><div class="notice">Register your interest below. The team confirms dates, suitability, available places and payment arrangements. Submission alone does not reserve a place.</div></>}
    <Fragment slot="aside">{course && <div class="aside-panel"><span class="eyebrow">Plan your learning</span><h2>Session information</h2><p><strong>When:</strong> {formatDate(course.date)}</p><p><strong>Where:</strong> {course.location || 'Confirmed with the team'}</p><p><strong>Fee:</strong> {course.price != null ? money(course.price) : 'Confirmed with the team'}{course.capacity && <><br /><strong>Group size:</strong> Up to {course.capacity} participants</>}</p>{!preview && <div class="actions"><a class="button" href={`/support?kind=training-group&course=${course.slug}`}>Register interest <CareIcon name="arrow-right" /></a><a class="text-link" href={`/support?kind=training-private&course=${course.slug}`}>Ask about private training <CareIcon name="arrow-right" /></a></div>}</div>}</Fragment>
  </ContentFrame>
</SiteLayout>
