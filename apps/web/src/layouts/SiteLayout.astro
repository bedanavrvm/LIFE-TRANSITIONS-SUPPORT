---
import '../styles/global.css';
import { demoMode } from '../lib/cms';
import type { SiteSettings } from '@ltsp/shared';
interface Props { title?: string; description?: string; settings?: SiteSettings; }
const { title = 'Care through life’s changes', description = 'Nurse-led support for families in Nairobi through parenthood, caregiving, illness, recovery and loss.', settings = {} } = Astro.props;
const path = Astro.url.pathname;
const navigation = [['Services', '/services'], ['Caregiver training', '/training'], ['Our approach', '/about'], ['Resources', '/resources']];
---
<!doctype html>
<html lang="en" data-page={path === '/' ? 'home' : 'content'}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Life Transitions Support Partners</title><meta name="description" content={description} />
    <meta name="theme-color" content="#244c40" /><meta name="robots" content={demoMode ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="preload" href="/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {demoMode && <div class="preview-note">Local preview · Please use fictional details. Service arrangements and course dates are illustrative until confirmed.</div>}
    <header class="header-shell"><div class="site-header wrap">
      <a href="/" class="brand" aria-label="Life Transitions Support Partners home"><img src="/mark.svg" width="44" height="44" alt="" /><span>Life Transitions<small>SUPPORT PARTNERS</small></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">{navigation.map(([label, href]) => <a class:list={{ active: path.startsWith(href) }} href={href}>{label}</a>)}</nav>
      <a class="button small header-cta" href="/support">Let’s talk <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation">{navigation.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/contact">Contact</a><a href="/support">Request support</a></nav></details>
    </div></header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="wrap footer-grid">
      <div><a class="brand" href="/"><img src="/mark.svg" width="40" height="40" alt="" /><span>Life Transitions<small>SUPPORT PARTNERS</small></span></a><p>No one should navigate life's transitions alone.</p><p class="muted">A nurse-led initiative · Nairobi, Kenya</p></div>
      <div><h2>Find your way</h2><a href="/services">Our services</a><a href="/training">Caregiver training</a><a href="/support?kind=referral">Refer someone</a><a href="/contact">Contact us</a></div>
      <div><h2>Here to listen</h2>{settings.phone && <a href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`}>{settings.phone}</a>}{settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}<p>{settings.responseNote || 'Send a request and agree a suitable time to speak with the team.'}</p><a href="/support">Request a callback ↗</a></div>
    </div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Life Transitions Support Partners</span><a href="/privacy">Privacy & your information</a><span>This service does not provide emergency response.</span></div></footer>
  </body>
  <script>import '../scripts/header';</script>
</html>
