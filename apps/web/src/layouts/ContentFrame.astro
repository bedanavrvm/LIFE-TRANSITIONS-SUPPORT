---
import PageIntro from '../components/PageIntro.astro';
interface Props { class?: string; toc?: boolean; }
const { class: className, toc = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<div class:list={['content-frame', className]}>
  <PageIntro><slot name="intro" /></PageIntro>
  <div class:list={['content-columns', 'wrap', { 'has-aside': hasAside, 'has-toc': toc }]}>
    {toc && hasAside && <aside class="content-aside"><slot name="aside" /></aside>}
    <div class="article-copy"><slot /></div>
    {!toc && hasAside && <aside class="content-aside"><slot name="aside" /></aside>}
  </div>
</div>
