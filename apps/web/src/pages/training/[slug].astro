---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContentFrame from '../../layouts/ContentFrame.astro';
import CarePhoto from '../../components/CarePhoto.astro';
import { coursePhotography } from '../../lib/photography';
import { publicContent, formatDate, money } from '../../lib/cms';
const { courses, settings, available } = await publicContent();
const course = courses.find(item => item.slug === Astro.params.slug);
if (!course) Astro.response.status = available ? 404 : 503;
---
<SiteLayout title={course?.title || 'Course unavailable'} settings={settings}>
  <ContentFrame>
    <Fragment slot="intro"><div class="breadcrumb"><a href="/training">Training</a> / {course?.title || 'Unavailable'}</div><span class="eyebrow">{course?.audience || 'Caregiver training'}</span><h1>{course?.title || 'We couldn’t find that course.'}</h1><p>{course?.summary || 'Please return to the training page or try again shortly.'}</p></Fragment>
    {course && <><CarePhoto photo={coursePhotography[course.slug] ?? 'companionship'} class="detail-photo" sizes="(max-width: 1100px) calc(100vw - 48px), 876px" /><p>{course.details}</p><div class="notice">Register your interest below. The team confirms dates, suitability, available places and payment arrangements. Submission alone does not reserve a place.</div></>}
    <Fragment slot="aside">{course && <div class="aside-panel"><span class="eyebrow">Plan your learning</span><h2>Session information</h2><p><strong>When:</strong> {formatDate(course.date)}</p><p><strong>Where:</strong> {course.location || 'Confirmed with the team'}</p><p><strong>Fee:</strong> {course.price != null ? money(course.price) : 'Confirmed with the team'}{course.capacity && <><br /><strong>Group size:</strong> Up to {course.capacity} participants</>}</p><div class="actions"><a class="button" href={`/support?kind=training-group&course=${course.slug}`}>Register interest ↗</a><a class="text-link" href={`/support?kind=training-private&course=${course.slug}`}>Ask about private training ↗</a></div></div>}</Fragment>
  </ContentFrame>
</SiteLayout>
