---
import PageIntro from '../../components/PageIntro.astro';
import CareIcon from '../../components/CareIcon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CarePhoto from '../../components/CarePhoto.astro';
import { coursePhotography } from '../../lib/photography';
import { publicContent, formatDate, money } from '../../lib/cms';
const { courses, settings, available } = await publicContent();
---
<SiteLayout title="Caregiver training" settings={settings}><PageIntro><span class="eyebrow">Learn to care with confidence</span><h1>Practical learning.<br />More confident care.</h1><p>Training for nannies, domestic managers and home caregivers. Explore scheduled groups or ask about a private session for your family or organisation.</p></PageIntro><div class="wrap">{!available && <p class="notice error">Training information is temporarily unavailable. Please try again shortly.</p>}<div class="course-grid">{courses.map(course => <article class="course-card"><div class="course-art"><CarePhoto asset={course.image} photo={coursePhotography[course.slug] ?? 'companionship'} sizes="(max-width: 780px) calc(100vw - 36px), (max-width: 1340px) 30vw, 400px" /></div><div class="course-body"><span class="tag">{course.audience}</span><h2>{course.title}</h2><p>{course.summary}</p><div class="course-meta">{formatDate(course.date)}<br />{course.price != null ? money(course.price) : 'Fee confirmed by the team'}</div><a class="text-link" href={`/training/${course.slug}`}>Course details & registration <CareIcon name="arrow-right" /></a></div></article>)}</div><section class="section"><div class="care-banner"><div><span class="eyebrow">Learning that fits your household</span><h2>Prefer a private session?</h2><p>Tell us who you want to train and the support you need. The team will discuss suitable arrangements and a quote.</p></div><a class="button light" href="/support?kind=training-private">Request private training <CareIcon name="arrow-right" /></a></div></section></div></SiteLayout>
