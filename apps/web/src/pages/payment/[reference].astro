---
import CareIcon from '../../components/CareIcon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { cms, demoMode, money } from '../../lib/cms';
import { safeCheckoutUrl } from '@ltsp/shared';
type Payment = { reference: string; amount: number; status: 'pending' | 'paid' | 'cancelled'; checkoutUrl?: string | null };
let payment: Payment | null = null;
try { payment = await cms<Payment>(`payment-summary/${encodeURIComponent(Astro.params.reference || '')}`, { headers: { 'x-internal-key': process.env.INTERNAL_API_KEY || '' } }); } catch { Astro.response.status = 404; }
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
---
<SiteLayout title="Your payment"><div class="wrap"><div class="payment-card"><span class="eyebrow">Life Transitions Support Partners</span><h1>{!payment ? 'Payment link unavailable' : payment.status === 'paid' ? 'Payment verified' : payment.status === 'cancelled' ? 'Payment cancelled' : 'Your agreed payment'}</h1>{payment ? <><p class="amount">{money(payment.amount)}</p><p>{payment.status === 'paid' ? 'The team has checked the transaction and recorded payment.' : payment.status === 'cancelled' ? 'Please contact the team before making a payment.' : 'Please check that this matches the amount agreed with the team.'}</p>{payment.status === 'pending' && (demoMode ? <div class="notice">This local preview does not take payments. Provider checkout must be configured and verified before use.</div> : payment.checkoutUrl && safeCheckoutUrl(payment.checkoutUrl) ? <div class="actions" style="justify-content:center"><a class="button" href={payment.checkoutUrl} rel="noreferrer">Continue to secure checkout <CareIcon name="external" /></a></div> : <div class="notice">The team has not supplied a checkout link yet. Please contact them before paying.</div>)}<p class="muted payment-note">Reference: {payment.reference}</p><p class="muted payment-note">Returning from checkout does not automatically confirm payment. The team verifies the provider’s transaction record.</p></> : <p>Please check the link supplied by the team or contact them for help.</p>}<div class="actions" style="justify-content:center"><a class="text-link" href="/contact">Contact the team</a></div></div></div></SiteLayout>
