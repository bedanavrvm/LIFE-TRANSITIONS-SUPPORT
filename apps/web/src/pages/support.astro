---
import SiteLayout from '../layouts/SiteLayout.astro';
import SupportForm from '../components/SupportForm.astro';
import { publicContent, cms } from '../lib/cms';
import { requestKinds, requestSchema } from '@ltsp/shared';
const content = await publicContent();
const values: Record<string, string> = { kind: 'care', preferredContact: 'phone', relationship: 'self', ageGroup: 'adult', ...Object.fromEntries(['kind', 'service', 'course'].map(key => [key, Astro.url.searchParams.get(key) || (key === 'kind' ? 'care' : '')])) };
if (!requestKinds.includes(values.kind as typeof requestKinds[number])) values.kind = 'care';
const errors: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    for (const key of ['kind', 'name', 'phone', 'email', 'preferredContact', 'service', 'course', 'relationship', 'ageGroup', 'area', 'availability', 'message', 'consent']) values[key] = String(form.get(key) || '');
    const parsed = requestSchema.safeParse({ ...values, consent: values.consent === 'on' });
    if (String(form.get('website') || '')) errors.name = 'We couldn’t accept this request. Please try again.';
    else if (!parsed.success) for (const issue of parsed.error.issues) errors[String(issue.path[0])] = issue.message;
    else {
      const result = await cms<{ reference: string }>('intake', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-internal-key': process.env.INTERNAL_API_KEY || '' }, body: JSON.stringify(parsed.data) });
      return Astro.redirect(`/thanks?reference=${encodeURIComponent(result.reference)}`, 303);
    }
    Astro.response.status = 400;
  } catch { errors.name = 'Your request has not been saved. Please try again shortly; your entries are still below.'; Astro.response.status = 503; }
}
---
<SiteLayout title="Request support" settings={content.settings}><div class="wrap"><header class="page-intro"><span class="eyebrow">You can start here</span><h1>Whatever brings you here,<br />we’re ready to listen.</h1><p>Take the first step at your own pace. A nurse will review your request before any care appointment is agreed.</p></header><div class="form-layout"><SupportForm services={content.services} courses={content.courses} values={values} errors={errors} /><aside class="form-aside"><h2>What happens next?</h2><p>A nurse reviews your enquiry and gets in touch using your preferred contact method.</p><p>Together, you discuss the right support, availability and any fees. There is no payment required to send a request.</p><div class="aside-box"><h3>Reaching out for someone?</h3><p>Choose your relationship in the form. We’ll discuss the appropriate permissions and next steps with you.</p></div><div class="aside-box"><h3>Support through loss</h3><p>Spiritual and bereavement support is complimentary.</p><a class="text-link" href="/services/spiritual-bereavement">Find out what’s included ↗</a></div><div class="aside-box"><p>This service does not provide emergency response. Do not wait for a website reply when urgent medical assistance is needed.</p></div></aside></div></div></SiteLayout>
