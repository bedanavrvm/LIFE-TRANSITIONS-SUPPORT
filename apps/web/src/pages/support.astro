---
import PageIntro from '../components/PageIntro.astro';
import CareIcon from '../components/CareIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import SupportForm from '../components/SupportForm.astro';
import { publicContent, cms } from '../lib/cms';
import { requestKinds, requestSchema } from '@ltsp/shared';
const content = await publicContent();
const values: Record<string, string> = { kind: 'care', preferredContact: 'phone', ...Object.fromEntries(['kind', 'service', 'course'].map(key => [key, Astro.url.searchParams.get(key) || (key === 'kind' ? 'care' : '')])) };
if (!requestKinds.includes(values.kind as typeof requestKinds[number])) values.kind = 'care';
if (content.available && !content.services.some(service => service.slug === values.service)) values.service = '';
if (content.available && !content.courses.some(course => course.slug === values.course)) values.course = '';
const errors: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    for (const key of ['kind', 'name', 'phone', 'email', 'preferredContact', 'service', 'course', 'relationship', 'ageGroup', 'area', 'availability', 'message', 'consent']) values[key] = String(form.get(key) || '');
    const parsed = requestSchema.safeParse({
      ...values,
      phone: values.preferredContact === 'email' ? '' : values.phone.trim(),
      email: values.preferredContact === 'email' ? values.email.trim() : '',
      course: values.kind.startsWith('training-') ? values.course : '',
      relationship: values.relationship || undefined,
      ageGroup: values.ageGroup || undefined,
      consent: values.consent === 'on',
    });
    if (String(form.get('website') || '')) errors.name = 'We couldn’t accept this request. Please try again.';
    else if (!parsed.success) for (const issue of parsed.error.issues) errors[String(issue.path[0])] = issue.message;
    else if (content.available && values.service && !content.services.some(service => service.slug === values.service)) {
      errors.kind = 'This service is unavailable. Choose how we can help and send again.';
      values.service = '';
    } else if (content.available && parsed.data.course && !content.courses.some(course => course.slug === parsed.data.course)) {
      errors.course = 'This course is unavailable. Choose another course or ask us for advice.';
    } else {
      const result = await cms<{ reference: string }>('intake', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-internal-key': process.env.INTERNAL_API_KEY || '' }, body: JSON.stringify(parsed.data) });
      return Astro.redirect(`/thanks?reference=${encodeURIComponent(result.reference)}`, 303);
    }
    Astro.response.status = 400;
  } catch { errors.form = 'We couldn’t confirm your request was saved. Your entries are still below; please try again shortly.'; Astro.response.status = 503; }
}
---
<SiteLayout title={Object.keys(errors).length ? 'Check your request' : 'Request support'} settings={content.settings}>
  <PageIntro class="support-intro"><span class="eyebrow">You can start here</span><h1>We’re ready to listen.</h1><p>Tell us how to reach you. The details can wait for a conversation with a nurse.</p></PageIntro><div class="wrap">
    <div class="form-layout">
      <SupportForm services={content.services} courses={content.courses} values={values} errors={errors} />
      <aside class="form-aside">
        <span class="eyebrow">One step at a time</span><h2>What happens next?</h2>
        <ol class="next-steps"><li>A nurse reviews your enquiry and replies using your chosen contact method.</li><li>You discuss the right support, availability and any fees before arrangements are confirmed.</li></ol>
        <div class="aside-box"><h3>Support through loss</h3><p>Spiritual and bereavement support is complimentary.</p><a class="text-link" href="/services/spiritual-bereavement">What’s included <CareIcon name="arrow-right" /></a></div>
        <p class="small-note">Seek urgent medical assistance when needed; don’t wait for a website reply.</p>
      </aside>
    </div>
  </div>
</SiteLayout>
