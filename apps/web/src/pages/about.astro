---
import CareIcon from '../components/CareIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ContentFrame from '../layouts/ContentFrame.astro';
import CarePhoto from '../components/CarePhoto.astro';
import { publicContent } from '../lib/cms';
const { settings } = await publicContent();
---
<SiteLayout title="Our approach" settings={settings}>
  <ContentFrame>
    <Fragment slot="intro"><span class="eyebrow">Life Transitions Support Partners</span><h1>Care begins with<br />seeing the whole person.</h1><p>A nurse-led initiative rooted in family, community and the belief that no one should face major life transitions alone.</p></Fragment>
    <p>{settings.aboutText || 'We support individuals and families in Nairobi through childbirth, caregiving, chronic and terminal illness, bereavement, and recovery after hospital discharge. Our approach considers psychological, educational, spiritual and practical needs alongside clinical care.'}</p>
    <h2>Alongside your family</h2><p>Support can mean preparing for motherhood, learning how to care for someone at home, finding the right professional, or having someone present through loss. We start by listening and agree the next step with you.</p>
    <div class="principles"><div><h3>Compassion</h3><p>We meet people with kindness and respect for their circumstances.</p></div><div><h3>Professionalism</h3><p>We discuss appropriate support and recognise when a specialist referral is needed.</p></div><div><h3>Confidentiality</h3><p>Your information should be shared only for the support you need and with appropriate permissions.</p></div><div><h3>Trustworthiness</h3><p>Clear explanations of arrangements, responsibilities and any fees.</p></div></div>
    <h2>Know who will support you</h2><p>Before an appointment, ask the team who will provide your support, their relevant qualifications, and what the service includes. Specialist interventions are arranged through appropriate professional referrals.</p>
    <Fragment slot="aside"><CarePhoto photo="companionship" class="aside-photo" sizes="(max-width: 1100px) calc(100vw - 48px), 340px" /><div class="aside-panel"><span class="eyebrow">Here for your next step</span><h2>Start with a conversation.</h2><div class="actions"><a class="button" href="/support">Start a conversation <CareIcon name="arrow-right" /></a><a class="text-link" href="/support?kind=referral">Refer someone</a></div></div></Fragment>
  </ContentFrame>
</SiteLayout>
