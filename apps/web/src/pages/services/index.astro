---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publicContent } from '../../lib/cms';
const { services, settings, available } = await publicContent();
---
<SiteLayout title="Support for your family" settings={settings}><div class="wrap"><header class="page-intro"><span class="eyebrow">Our services</span><h1>Support for the whole family.</h1><p>From the practical to the deeply personal, find guidance for the transition your family is navigating.</p></header>{!available && <p class="notice error">Service information is temporarily unavailable. Please try again shortly.</p>}<div class="service-list">{services.map(service => <article class="service-card"><span class="number">{service.number}</span><h2>{service.title}</h2><p>{service.summary}</p>{service.free && <span class="badge">Complimentary support</span>}<br /><a class="text-link" href={`/services/${service.slug}`}>Find out more ↗</a></article>)}</div></div></SiteLayout>
