---
import SiteLayout from '../layouts/SiteLayout.astro';
const reference = Astro.url.searchParams.get('reference') || '';
const valid = /^LT-[A-F\d]{8}$/.test(reference);
---
<SiteLayout title="Request received"><div class="wrap reading"><header class="page-intro"><span class="success-mark" aria-hidden="true">✓</span><h1>Thank you for reaching out.</h1><p>Your request has been received. A nurse will review it and contact you to discuss the next step.</p></header>{valid && <div class="notice">Your request reference: <strong>{reference}</strong></div>}<p>An appointment or course place is confirmed separately by the team. You do not need to make a payment at this stage.</p><div class="actions"><a class="button" href="/">Return home</a><a class="text-link" href="/resources">Preparing for our conversation ↗</a></div></div></SiteLayout>
