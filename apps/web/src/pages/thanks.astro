---
import PageIntro from '../components/PageIntro.astro';
import CareIcon from '../components/CareIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
const reference = Astro.url.searchParams.get('reference') || '';
const valid = /^LT-[A-F\d]{8}$/.test(reference);
---
<SiteLayout title="Request received"><PageIntro class="reading"><span class="success-mark"><CareIcon name="success" /></span><h1>Thank you for reaching out.</h1><p>Your request has been received. A nurse will review it and contact you to discuss the next step.</p></PageIntro><div class="wrap reading">{valid && <div class="notice">Your request reference: <strong>{reference}</strong></div>}<p>An appointment or course place is confirmed separately by the team. You do not need to make a payment at this stage.</p><div class="actions"><a class="button" href="/">Return home</a><a class="text-link" href="/resources">Preparing for our conversation <CareIcon name="arrow-right" /></a></div></div></SiteLayout>
