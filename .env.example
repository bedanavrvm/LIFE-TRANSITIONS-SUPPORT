PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_API_KEY=replace-with-another-random-secret-of-at-least-32-characters
CMS_URL=http://127.0.0.1:3000
WEB_URL=http://127.0.0.1:4321
# Optional: DATABASE_URI=file:C:/absolute/path/to/development.sqlite
# Local previews accept synthetic data only. Review production controls before changing this.
DEMO_MODE=true

# Combined production service: set WEB_URL before building (for example http://127.0.0.1:8080).
# Render supplies PORT; the launcher keeps the two app ports private.
# Legacy DATABASE_URI can supply an explicit connection; Neon CLI variables are documented below.
# PostgreSQL requires reviewed migrations: npm run payload -- migrate
# Render startup seeds missing public content automatically and creates only the first administrator.
# Set INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD (12+ characters) in Render's Environment settings.
# Optional INITIAL_ADMIN_NAME; existing accounts/passwords are never replaced by bootstrap settings.

# Neon CLI writes these into .env (or .env.local); never commit real values.
# DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require
# Runtime uses DATABASE_URL. Payload migrations select DATABASE_URL_UNPOOLED.
# An explicit DATABASE_URI takes precedence over both, including isolated local/test SQLite files.
